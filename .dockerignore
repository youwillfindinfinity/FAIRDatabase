# Git
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
venv/
.venv/
backend/venv/
backend/.venv/

# Environment files (injected at runtime, not baked into image)
.env
backend/.env
backend/tests/.env.test

# Supabase runtime volumes — exclude the whole tree; postgres data dir is
# root-owned (mode 700) and unreadable by the build user, which makes
# BuildKit's context sender fail before .dockerignore narrows the walk.
backend/volumes

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code
.claude/

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
*.cover

# OS
.DS_Store
Thumbs.db

# Docs
*.md
!frontend/**/*.md
